      definition: "CREATE OR REPLACE FUNCTION audit.capture_statement_change()\n RETURNS trigger\n LANGUAGE plpgsql\nAS $function$\nBEGIN\n    RETURN NULL;\nEND;\n$function$\n"
      comment: ~
      return_type: trigger
      language: plpgsql
      volatility: volatile
      parallel: unsafe
      security_definer: false
