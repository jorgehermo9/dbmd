      target_namespace: audit
      target: accounts
      timing: after
      events:
        - event: truncate
      orientation: statement
      comment: ~
      when_expression: ~
      definition: CREATE TRIGGER accounts_truncate AFTER TRUNCATE ON audit.accounts FOR EACH STATEMENT EXECUTE FUNCTION audit.capture_statement_change()
      function: audit.capture_statement_change()
      arguments: []
      enabled: replica
      constraint: ~
      old_transition_table: ~
      new_transition_table: ~
      parent_trigger: ~
    - namespace: audit
      name: zz_accounts_change
      target_namespace: audit
      target: accounts
      timing: before
      events:
        - event: insert
        - event: update
          columns:
            - email
            - balance
        - event: delete
      orientation: row
      comment: Captures relevant account row changes
      when_expression: pg_trigger_depth() = 0
      definition: "CREATE TRIGGER zz_accounts_change BEFORE INSERT OR DELETE OR UPDATE OF email, balance ON audit.accounts FOR EACH ROW WHEN (pg_trigger_depth() = 0) EXECUTE FUNCTION audit.capture_row_change('history', 'full')"
      function: audit.capture_row_change()
      arguments:
        - history
        - full
      enabled: always
      constraint: ~
      old_transition_table: ~
      new_transition_table: ~
      parent_trigger: ~
  functions:
    - namespace: audit
      name: capture_row_change
      signature: ()
      definition: "CREATE OR REPLACE FUNCTION audit.capture_row_change()\n RETURNS trigger\n LANGUAGE plpgsql\nAS $function$\nBEGIN\n    RETURN COALESCE(NEW, OLD);\nEND;\n$function$\n"
      comment: ~
      return_type: trigger
      language: plpgsql
      volatility: volatile
      parallel: unsafe
      security_definer: false
    - namespace: audit
