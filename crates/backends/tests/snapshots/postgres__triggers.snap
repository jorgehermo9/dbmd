      target_namespace: audit
      target: accounts
      timing: after
      events:
        - event: update
          columns:
            - balance
      orientation: row
      comment: ~
      when_expression: new.balance < 0
      definition: "CREATE CONSTRAINT TRIGGER accounts_balance_constraint AFTER UPDATE OF balance ON audit.accounts FROM audit.account_limits DEFERRABLE INITIALLY DEFERRED FOR EACH ROW WHEN (new.balance < 0) EXECUTE FUNCTION audit.capture_row_change('balance')"
      function: audit.capture_row_change()
      arguments:
        - balance
      enabled: origin
      constraint:
        referenced_table: audit.account_limits
        deferrable: true
        initially_deferred: true
      old_transition_table: ~
      new_transition_table: ~
      parent_trigger: ~
    - namespace: audit
      name: accounts_transition
      target_namespace: audit
      target: accounts
      timing: after
      events:
        - event: update
          columns: []
      orientation: statement
      comment: ~
      when_expression: ~
      definition: CREATE TRIGGER accounts_transition AFTER UPDATE ON audit.accounts REFERENCING OLD TABLE AS previous_rows NEW TABLE AS current_rows FOR EACH STATEMENT EXECUTE FUNCTION audit.capture_statement_change()
      function: audit.capture_statement_change()
      arguments: []
      enabled: disabled
      constraint: ~
      old_transition_table: previous_rows
      new_transition_table: current_rows
      parent_trigger: ~
    - namespace: audit
