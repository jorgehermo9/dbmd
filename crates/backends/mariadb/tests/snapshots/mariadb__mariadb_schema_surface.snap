  role_memberships:
    - user: analytics_service
      host: localhost
      role: analytics_reader
      admin_option: true
    - user: root
      host: localhost
      role: analytics_reader
      admin_option: true
  privileges:
    - grantee: "'analytics_reader'@''"
      object_kind: function
      schema: test
      object: normalize_email
      column: ~
      privilege: EXECUTE
      grantable: false
    - grantee: "'analytics_reader'@''"
      object_kind: package
      schema: test
      object: analytics_tools
      column: ~
      privilege: EXECUTE
      grantable: false
    - grantee: "'analytics_reader'@''"
      object_kind: schema
      schema: test
      object: ~
      column: ~
      privilege: SELECT
      grantable: false
    - grantee: "'analytics_reader'@''"
      object_kind: schema
      schema: test
      object: ~
      column: ~
      privilege: SHOW CREATE ROUTINE
      grantable: false
    - grantee: "'analytics_service'@'localhost'"
      object_kind: global
      schema: ~
      object: ~
      column: ~
      privilege: USAGE
      grantable: true
    - grantee: "'analytics_service'@'localhost'"
      object_kind: proxy
      schema: ~
      object: "'proxy_target'@'localhost'"
      column: ~
      privilege: PROXY
      grantable: true
    - grantee: "'healthcheck'@'127.0.0.1'"
      object_kind: global
      schema: ~
      object: ~
      column: ~
      privilege: USAGE
      grantable: false
    - grantee: "'healthcheck'@'::1'"
      object_kind: global
      schema: ~
      object: ~
      column: ~
      privilege: USAGE
      grantable: false
    - grantee: "'healthcheck'@'localhost'"
      object_kind: global
      schema: ~
      object: ~
      column: ~
      privilege: USAGE
      grantable: false
    - grantee: "'mariadb.sys'@'localhost'"
      object_kind: global
      schema: ~
      object: ~
      column: ~
      privilege: USAGE
      grantable: false
    - grantee: "'proxy_target'@'localhost'"
      object_kind: global
      schema: ~
      object: ~
      column: ~
      privilege: USAGE
      grantable: false
    - grantee: "'root'@'%'"
      object_kind: global
      schema: ~
      object: ~
      column: ~
      privilege: ALTER
      grantable: true
    - grantee: "'root'@'%'"
      object_kind: global
      schema: ~
      object: ~
      column: ~
      privilege: ALTER ROUTINE
      grantable: true
    - grantee: "'root'@'%'"
      object_kind: global
      schema: ~
      object: ~
