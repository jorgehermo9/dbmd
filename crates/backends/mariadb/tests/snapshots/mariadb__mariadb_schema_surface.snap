---
source: crates/backends/mariadb/tests/mariadb.rs
expression: first
---
id: commerce
display_name: ~
catalog:
  schemas:
    - name: test
      default_character_set: utf8mb4
      default_collation: utf8mb4_uca1400_ai_ci
  tables:
    - schema: test
      name: accounts
      engine: InnoDB
      row_format: Dynamic
      collation: utf8mb4_uca1400_ai_ci
      comment: Versioned user accounts
      create_options: ~
      system_versioned: true
      system_time_period:
        start_column: row_start
        end_column: row_end
      columns:
        - name: tenant_id
          position: 1
          data_type: bigint
          column_type: bigint(20) unsigned
          nullable: false
          default: ~
          extra: ""
          generation_expression: ~
          character_set: ~
          collation: ~
          comment: ~
        - name: account_id
          position: 2
          data_type: bigint
          column_type: bigint(20) unsigned
          nullable: false
          default: ~
          extra: auto_increment
          generation_expression: ~
          character_set: ~
          collation: ~
          comment: ~
        - name: email
          position: 3
          data_type: varchar
          column_type: varchar(255)
          nullable: false
          default: ~
          extra: ""
          generation_expression: ~
          character_set: utf8mb4
          collation: utf8mb4_uca1400_ai_ci
          comment: ~
        - name: normalized_email
          position: 4
          data_type: varchar
          column_type: varchar(255)
          nullable: true
          default: "NULL"
          extra: STORED GENERATED
          generation_expression: "lcase(`email`)"
          character_set: utf8mb4
          collation: utf8mb4_uca1400_ai_ci
          comment: ~
        - name: status
          position: 5
          data_type: enum
          column_type: "enum('active','disabled')"
          nullable: false
          default: "'active'"
          extra: ""
          generation_expression: ~
          character_set: utf8mb4
          collation: utf8mb4_uca1400_ai_ci
          comment: ~
        - name: row_start
          position: 6
          data_type: timestamp
          column_type: timestamp(6)
          nullable: false
          default: ~
          extra: STORED GENERATED
          generation_expression: ROW START
          character_set: ~
          collation: ~
          comment: ~
        - name: row_end
          position: 7
          data_type: timestamp
          column_type: timestamp(6)
          nullable: false
          default: ~
          extra: STORED GENERATED
          generation_expression: ROW END
          character_set: ~
          collation: ~
          comment: ~
      constraints:
        - name: PRIMARY
          kind: primary_key
          columns:
            - account_id
            - row_end
          referenced_schema: ~
          referenced_table: ~
          referenced_columns: []
          match_option: ~
          update_rule: ~
          delete_rule: ~
          expression: ~
        - name: accounts_email_check
          kind: check
          columns: []
          referenced_schema: ~
          referenced_table: ~
          referenced_columns: []
          match_option: ~
          update_rule: ~
          delete_rule: ~
          expression: "`email` <> ''"
        - name: accounts_tenant_email_uq
          kind: unique
          columns:
            - tenant_id
            - email
            - row_end
          referenced_schema: ~
          referenced_table: ~
          referenced_columns: []
          match_option: ~
          update_rule: ~
          delete_rule: ~
          expression: ~
        - name: accounts_tenant_fk
          kind: foreign_key
          columns:
            - tenant_id
          referenced_schema: test
          referenced_table: tenants
          referenced_columns:
            - tenant_id
          match_option: NONE
          update_rule: CASCADE
          delete_rule: RESTRICT
          expression: ~
      indexes:
        - name: PRIMARY
          unique: true
          index_type: BTREE
          ignored: false
          comment: ~
          terms:
            - position: 1
              column: account_id
              prefix_length: ~
              descending: false
            - position: 2
              column: row_end
              prefix_length: ~
              descending: false
        - name: accounts_email_ignored_idx
          unique: false
          index_type: BTREE
          ignored: true
          comment: ~
          terms:
            - position: 1
              column: email
              prefix_length: ~
              descending: false
        - name: accounts_tenant_email_uq
          unique: true
          index_type: BTREE
          ignored: false
          comment: ~
          terms:
            - position: 1
              column: tenant_id
              prefix_length: ~
              descending: false
            - position: 2
              column: email
              prefix_length: 120
              descending: false
            - position: 3
              column: row_end
              prefix_length: ~
              descending: false
      partitions: []
      definition: "CREATE TABLE `accounts` (\n  `tenant_id` bigint(20) unsigned NOT NULL,\n  `account_id` bigint(20) unsigned NOT NULL AUTO_INCREMENT,\n  `email` varchar(255) NOT NULL,\n  `normalized_email` varchar(255) GENERATED ALWAYS AS (lcase(`email`)) STORED,\n  `status` enum('active','disabled') NOT NULL DEFAULT 'active',\n  `row_start` timestamp(6) GENERATED ALWAYS AS ROW START,\n  `row_end` timestamp(6) GENERATED ALWAYS AS ROW END,\n  PRIMARY KEY (`account_id`,`row_end`),\n  UNIQUE KEY `accounts_tenant_email_uq` (`tenant_id`,`email`(120),`row_end`),\n  KEY `accounts_email_ignored_idx` (`email`) IGNORED,\n  PERIOD FOR SYSTEM_TIME (`row_start`, `row_end`),\n  CONSTRAINT `accounts_tenant_fk` FOREIGN KEY (`tenant_id`) REFERENCES `tenants` (`tenant_id`) ON UPDATE CASCADE,\n  CONSTRAINT `accounts_email_check` CHECK (`email` <> '')\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_uca1400_ai_ci COMMENT='Versioned user accounts' WITH SYSTEM VERSIONING"
    - schema: test
      name: monthly_metrics
      engine: InnoDB
      row_format: Dynamic
      collation: utf8mb4_uca1400_ai_ci
      comment: ~
      create_options: partitioned
      system_versioned: false
      system_time_period: ~
      columns:
        - name: occurred_on
          position: 1
          data_type: date
          column_type: date
          nullable: false
          default: ~
          extra: ""
          generation_expression: ~
          character_set: ~
          collation: ~
          comment: ~
        - name: metric
          position: 2
          data_type: varchar
          column_type: varchar(64)
          nullable: false
          default: ~
          extra: ""
          generation_expression: ~
          character_set: utf8mb4
          collation: utf8mb4_uca1400_ai_ci
          comment: ~
        - name: value
          position: 3
          data_type: bigint
          column_type: bigint(20)
          nullable: false
          default: ~
          extra: ""
          generation_expression: ~
          character_set: ~
          collation: ~
          comment: ~
      constraints:
        - name: PRIMARY
          kind: primary_key
          columns:
            - occurred_on
            - metric
          referenced_schema: ~
          referenced_table: ~
          referenced_columns: []
          match_option: ~
          update_rule: ~
          delete_rule: ~
          expression: ~
      indexes:
        - name: PRIMARY
          unique: true
          index_type: BTREE
          ignored: false
          comment: ~
          terms:
            - position: 1
              column: occurred_on
              prefix_length: ~
              descending: false
            - position: 2
              column: metric
              prefix_length: ~
              descending: false
      partitions:
        - name: p2025
          subpartition: ~
          method: RANGE
          expression: "year(`occurred_on`)"
          description: "2026"
          ordinal: 1
        - name: pmax
          subpartition: ~
          method: RANGE
          expression: "year(`occurred_on`)"
          description: MAXVALUE
          ordinal: 2
      definition: "CREATE TABLE `monthly_metrics` (\n  `occurred_on` date NOT NULL,\n  `metric` varchar(64) NOT NULL,\n  `value` bigint(20) NOT NULL,\n  PRIMARY KEY (`occurred_on`,`metric`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_uca1400_ai_ci\n PARTITION BY RANGE (year(`occurred_on`))\n(PARTITION `p2025` VALUES LESS THAN (2026) ENGINE = InnoDB,\n PARTITION `pmax` VALUES LESS THAN MAXVALUE ENGINE = InnoDB)"
    - schema: test
      name: tenants
      engine: InnoDB
      row_format: Dynamic
      collation: utf8mb4_uca1400_ai_ci
      comment: Application tenants
      create_options: ~
      system_versioned: false
      system_time_period: ~
      columns:
        - name: tenant_id
          position: 1
          data_type: bigint
          column_type: bigint(20) unsigned
          nullable: false
          default: ~
          extra: auto_increment
          generation_expression: ~
          character_set: ~
          collation: ~
          comment: ~
        - name: name
          position: 2
          data_type: varchar
          column_type: varchar(120)
          nullable: false
          default: ~
          extra: ""
          generation_expression: ~
          character_set: utf8mb4
          collation: utf8mb4_uca1400_ai_ci
          comment: Tenant display name
      constraints:
        - name: PRIMARY
          kind: primary_key
          columns:
            - tenant_id
          referenced_schema: ~
          referenced_table: ~
          referenced_columns: []
          match_option: ~
          update_rule: ~
          delete_rule: ~
          expression: ~
        - name: tenants_name_uq
          kind: unique
          columns:
            - name
          referenced_schema: ~
          referenced_table: ~
          referenced_columns: []
          match_option: ~
          update_rule: ~
          delete_rule: ~
          expression: ~
      indexes:
        - name: PRIMARY
          unique: true
          index_type: BTREE
          ignored: false
          comment: ~
          terms:
            - position: 1
              column: tenant_id
              prefix_length: ~
              descending: false
        - name: tenants_name_uq
          unique: true
          index_type: BTREE
          ignored: false
          comment: ~
          terms:
            - position: 1
              column: name
              prefix_length: ~
              descending: false
      partitions: []
      definition: "CREATE TABLE `tenants` (\n  `tenant_id` bigint(20) unsigned NOT NULL AUTO_INCREMENT,\n  `name` varchar(120) NOT NULL COMMENT 'Tenant display name',\n  PRIMARY KEY (`tenant_id`),\n  UNIQUE KEY `tenants_name_uq` (`name`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_uca1400_ai_ci COMMENT='Application tenants'"
  views:
    - schema: test
      name: active_accounts
      definition: "select `test`.`accounts`.`tenant_id` AS `tenant_id`,`test`.`accounts`.`account_id` AS `account_id`,`test`.`accounts`.`email` AS `email` from `test`.`accounts` where `test`.`accounts`.`status` = 'active'"
      check_option: CASCADED
      updatable: true
      security_type: INVOKER
      definer: root@localhost
      character_set: utf8mb4
      collation: utf8mb4_uca1400_ai_ci
      create_statement: "CREATE ALGORITHM=UNDEFINED DEFINER=`root`@`localhost` SQL SECURITY INVOKER VIEW `active_accounts` AS select `accounts`.`tenant_id` AS `tenant_id`,`accounts`.`account_id` AS `account_id`,`accounts`.`email` AS `email` from `accounts` where `accounts`.`status` = 'active' WITH CASCADED CHECK OPTION"
  sequences:
    - schema: test
      name: order_number_seq
      definition: "CREATE SEQUENCE `order_number_seq` start with 1000 minvalue 1 maxvalue 9223372036854775806 increment by 10 cache 20 nocycle ENGINE=InnoDB"
  routines:
    - schema: test
      name: disable_account
      kind: PROCEDURE
      return_type: ~
      definition: "UPDATE accounts SET status = 'disabled' WHERE account_id = target_id"
      deterministic: false
      sql_data_access: MODIFIES SQL DATA
      security_type: DEFINER
      definer: root@localhost
      comment: ~
      parameters:
        - position: 1
          mode: IN
          name: target_id
          data_type: bigint
          dtd_identifier: bigint(20) unsigned
    - schema: test
      name: normalize_email
      kind: FUNCTION
      return_type: varchar(255)
      definition: RETURN lower(value)
      deterministic: true
      sql_data_access: NO SQL
      security_type: DEFINER
      definer: root@localhost
      comment: ~
      parameters:
        - position: 0
          mode: ~
          name: ~
          data_type: varchar
          dtd_identifier: varchar(255)
        - position: 1
          mode: IN
          name: value
          data_type: varchar
          dtd_identifier: varchar(255)
  triggers:
    - schema: test
      name: accounts_updated
      table: accounts
      event: UPDATE
      timing: BEFORE
      orientation: ROW
      statement: "SET NEW.status = COALESCE(NEW.status, OLD.status)"
      action_order: 1
      sql_mode: "STRICT_TRANS_TABLES,ERROR_FOR_DIVISION_BY_ZERO,NO_AUTO_CREATE_USER,NO_ENGINE_SUBSTITUTION"
      definer: root@localhost
  events:
    - schema: test
      name: purge_disabled_accounts
      definer: root@localhost
      time_zone: SYSTEM
      event_type: RECURRING
      execute_at: ~
      interval_value: "1"
      interval_field: DAY
      starts: "2030-01-01 00:00:00"
      ends: ~
      status: DISABLED
      on_completion: PRESERVE
      comment: Remove old disabled accounts
      definition: "DELETE FROM accounts WHERE status = 'disabled' AND row_end < CURRENT_TIMESTAMP - INTERVAL 365 DAY"
