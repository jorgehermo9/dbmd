  accounts:
    - name: analytics_reader
      host: ""
      kind: role
      authentication_plugins: []
      password_expired: false
      password_lifetime_days: ~
      account_locked: false
      default_role: ~
      tls_requirement: none
      tls_cipher: ~
      x509_issuer: ~
      x509_subject: ~
      max_queries_per_hour: ~
      max_updates_per_hour: ~
      max_connections_per_hour: ~
      max_user_connections: ~
      max_statement_time: ~
    - name: analytics_service
      host: localhost
      kind: user
      authentication_plugins:
        - caching_sha2_password
      password_expired: false
      password_lifetime_days: 90
      account_locked: true
      default_role: analytics_reader
      tls_requirement: specified
      tls_cipher: TLS_AES_256_GCM_SHA384
      x509_issuer: /CN=dbmd-ca
      x509_subject: /CN=dbmd-client
      max_queries_per_hour: 17
      max_updates_per_hour: ~
      max_connections_per_hour: ~
      max_user_connections: 3
      max_statement_time: ~
    - name: healthcheck
      host: 127.0.0.1
      kind: user
      authentication_plugins:
        - mysql_native_password
      password_expired: false
      password_lifetime_days: ~
      account_locked: false
      default_role: ~
      tls_requirement: none
      tls_cipher: ~
      x509_issuer: ~
      x509_subject: ~
      max_queries_per_hour: ~
      max_updates_per_hour: ~
      max_connections_per_hour: ~
      max_user_connections: ~
      max_statement_time: ~
    - name: healthcheck
