      definition: "CREATE TABLE `tenant_embeddings` (\n  `tenant_id` bigint(20) unsigned NOT NULL,\n  `valid_from` date NOT NULL,\n  `valid_to` date NOT NULL,\n  `embedding` vector(5) NOT NULL,\n  `row_start` timestamp(6) GENERATED ALWAYS AS ROW START,\n  `row_end` timestamp(6) GENERATED ALWAYS AS ROW END,\n  PERIOD FOR `validity` (`valid_from`, `valid_to`),\n  UNIQUE KEY `tenant_validity_uq` (`tenant_id`,`row_end`,`validity` WITHOUT OVERLAPS),\n  VECTOR KEY `embedding_vector_idx` (`embedding`) `M`=8 `DISTANCE`=cosine,\n  PERIOD FOR SYSTEM_TIME (`row_start`, `row_end`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_uca1400_ai_ci COMMENT='Bitemporal tenant embeddings' WITH SYSTEM VERSIONING"
  views:
    - schema: test
      name: active_accounts
      definition: "select `test`.`accounts`.`tenant_id` AS `tenant_id`,`test`.`accounts`.`account_id` AS `account_id`,`test`.`accounts`.`email` AS `email` from `test`.`accounts` where `test`.`accounts`.`status` = 'active'"
      check_option: cascaded
      updatable: true
      security: invoker
      definer: root@localhost
      character_set: utf8mb4
      collation: utf8mb4_uca1400_ai_ci
      algorithm: merge
      create_statement: "CREATE ALGORITHM=MERGE DEFINER=`root`@`localhost` SQL SECURITY INVOKER VIEW `active_accounts` AS select `accounts`.`tenant_id` AS `tenant_id`,`accounts`.`account_id` AS `account_id`,`accounts`.`email` AS `email` from `accounts` where `accounts`.`status` = 'active' WITH CASCADED CHECK OPTION"
  sequences:
    - schema: test
      name: descending_order_seq
      data_type: bigint
      numeric_precision: 64
      numeric_precision_radix: 2
      numeric_scale: 0
      start_value: "0"
      minimum_value: "-20"
      maximum_value: "0"
      increment: "-2"
      cache: 0
      cycle: true
      engine: InnoDB
      comment: ~
      definition: "CREATE SEQUENCE `descending_order_seq` start with 0 minvalue -20 maxvalue 0 increment by -2 nocache cycle ENGINE=InnoDB"
    - schema: test
      name: order_number_seq
      data_type: bigint
      numeric_precision: 64
      numeric_precision_radix: 2
      numeric_scale: 0
      start_value: "1000"
      minimum_value: "1"
      maximum_value: "9223372036854775806"
      increment: "10"
      cache: 20
      cycle: false
      engine: InnoDB
      comment: ~
      definition: "CREATE SEQUENCE `order_number_seq` start with 1000 minvalue 1 maxvalue 9223372036854775806 increment by 10 cache 20 nocycle ENGINE=InnoDB"
  routines:
    - schema: test
      name: disable_account
      kind: procedure
      return_type: ~
      definition: "UPDATE accounts SET status = 'disabled' WHERE account_id = target_id"
      deterministic: false
      data_access: modifies_sql_data
      security: definer
      definer: root@localhost
      comment: ~
      parameters:
        - position: 1
          mode: in
          name: target_id
          data_type: bigint
          dtd_identifier: bigint(20) unsigned
          default: ~
      sql_mode: "STRICT_TRANS_TABLES,ERROR_FOR_DIVISION_BY_ZERO,NO_AUTO_CREATE_USER,NO_ENGINE_SUBSTITUTION"
      character_set_client: utf8mb4
      collation_connection: utf8mb4_uca1400_ai_ci
      database_collation: utf8mb4_uca1400_ai_ci
      create_statement: "CREATE DEFINER=`root`@`localhost` PROCEDURE `disable_account`(IN target_id BIGINT UNSIGNED)\n    MODIFIES SQL DATA\nUPDATE accounts SET status = 'disabled' WHERE account_id = target_id"
    - schema: test
      name: next_account_id
      kind: procedure
      return_type: ~
      definition: SET next_id = current_id + 1
      deterministic: false
      data_access: no_sql
      security: definer
      definer: root@localhost
      comment: ~
      parameters:
        - position: 1
          mode: in
          name: current_id
          data_type: bigint
          dtd_identifier: bigint(20) unsigned
          default: ~
        - position: 2
          mode: out
          name: next_id
          data_type: bigint
          dtd_identifier: bigint(20) unsigned
          default: ~
      sql_mode: "STRICT_TRANS_TABLES,ERROR_FOR_DIVISION_BY_ZERO,NO_AUTO_CREATE_USER,NO_ENGINE_SUBSTITUTION"
      character_set_client: utf8mb4
      collation_connection: utf8mb4_uca1400_ai_ci
      database_collation: utf8mb4_uca1400_ai_ci
      create_statement: "CREATE DEFINER=`root`@`localhost` PROCEDURE `next_account_id`(IN current_id BIGINT UNSIGNED, OUT next_id BIGINT UNSIGNED)\n    NO SQL\nSET next_id = current_id + 1"
    - schema: test
      name: normalize_email
      kind: function
      return_type: varchar(255)
      definition: RETURN lower(value)
      deterministic: true
      data_access: no_sql
      security: definer
      definer: root@localhost
      comment: ~
      parameters:
        - position: 0
          mode: ~
          name: ~
          data_type: varchar
          dtd_identifier: varchar(255)
          default: ~
        - position: 1
          mode: in
          name: value
          data_type: varchar
          dtd_identifier: varchar(255)
          default: "'fallback@example.invalid'"
      sql_mode: "STRICT_TRANS_TABLES,ERROR_FOR_DIVISION_BY_ZERO,NO_AUTO_CREATE_USER,NO_ENGINE_SUBSTITUTION"
      character_set_client: utf8mb4
      collation_connection: utf8mb4_uca1400_ai_ci
      database_collation: utf8mb4_uca1400_ai_ci
      create_statement: "CREATE DEFINER=`root`@`localhost` FUNCTION `normalize_email`(value VARCHAR(255) DEFAULT 'fallback@example.invalid') RETURNS varchar(255) CHARSET utf8mb4 COLLATE utf8mb4_uca1400_ai_ci\n    NO SQL\n    DETERMINISTIC\nRETURN lower(value)"
  packages:
    - schema: test
      name: analytics_tools
      definer: root@localhost
      security: invoker
      comment: Analytics package
      specification:
        definition: "CREATE DEFINER=`root`@`localhost` PACKAGE `analytics_tools`    SQL SECURITY INVOKER\n    COMMENT 'Analytics package'\n PROCEDURE refresh_cache(IN tenant BIGINT);\nFUNCTION normalize(value VARCHAR(255)) RETURNS VARCHAR(255);\nEND"
        sql_mode: "STRICT_TRANS_TABLES,ERROR_FOR_DIVISION_BY_ZERO,NO_AUTO_CREATE_USER,NO_ENGINE_SUBSTITUTION"
        character_set_client: utf8mb4
        collation_connection: utf8mb4_uca1400_ai_ci
        database_collation: utf8mb4_uca1400_ai_ci
      body:
        definition: "CREATE DEFINER=`root`@`localhost` PACKAGE BODY `analytics_tools` PROCEDURE refresh_cache(IN tenant BIGINT)\nBEGIN\n    SELECT tenant;\nEND;\nFUNCTION normalize(value VARCHAR(255)) RETURNS VARCHAR(255)\nRETURN lower(value);\nEND"
        sql_mode: "STRICT_TRANS_TABLES,ERROR_FOR_DIVISION_BY_ZERO,NO_AUTO_CREATE_USER,NO_ENGINE_SUBSTITUTION"
        character_set_client: utf8mb4
        collation_connection: utf8mb4_uca1400_ai_ci
        database_collation: utf8mb4_uca1400_ai_ci
  triggers:
    - schema: test
      name: accounts_changed
      table: accounts
      events:
        - insert
        - update
        - delete
      update_columns: []
      timing: after
      orientation: row
      statement: SET @dbmd_mariadb_account_changed = 1
      action_order: 1
      sql_mode: "STRICT_TRANS_TABLES,ERROR_FOR_DIVISION_BY_ZERO,NO_AUTO_CREATE_USER,NO_ENGINE_SUBSTITUTION"
      definer: root@localhost
      character_set_client: utf8mb4
      collation_connection: utf8mb4_uca1400_ai_ci
      database_collation: utf8mb4_uca1400_ai_ci
      create_statement: "CREATE DEFINER=`root`@`localhost` TRIGGER accounts_changed\nAFTER INSERT OR UPDATE OR DELETE ON accounts\nFOR EACH ROW SET @dbmd_mariadb_account_changed = 1"
    - schema: test
      name: accounts_updated
      table: accounts
      events:
        - update
      update_columns:
        - email
        - status
      timing: before
      orientation: row
      statement: "SET NEW.status = COALESCE(NEW.status, OLD.status)"
      action_order: 1
      sql_mode: "STRICT_TRANS_TABLES,ERROR_FOR_DIVISION_BY_ZERO,NO_AUTO_CREATE_USER,NO_ENGINE_SUBSTITUTION"
      definer: root@localhost
      character_set_client: utf8mb4
      collation_connection: utf8mb4_uca1400_ai_ci
      database_collation: utf8mb4_uca1400_ai_ci
      create_statement: "CREATE DEFINER=`root`@`localhost` TRIGGER accounts_updated\nBEFORE UPDATE OF status, email ON accounts\nFOR EACH ROW SET NEW.status = COALESCE(NEW.status, OLD.status)"
    - schema: test
      name: accounts_update_marker
      table: accounts
      events:
        - update
      update_columns: []
      timing: before
      orientation: row
      statement: SET @dbmd_mariadb_last_account = NEW.account_id
      action_order: 2
      sql_mode: "STRICT_TRANS_TABLES,ERROR_FOR_DIVISION_BY_ZERO,NO_AUTO_CREATE_USER,NO_ENGINE_SUBSTITUTION"
      definer: root@localhost
      character_set_client: utf8mb4
      collation_connection: utf8mb4_uca1400_ai_ci
      database_collation: utf8mb4_uca1400_ai_ci
      create_statement: "CREATE DEFINER=`root`@`localhost` TRIGGER accounts_update_marker\nBEFORE UPDATE ON accounts\nFOR EACH ROW\nSET @dbmd_mariadb_last_account = NEW.account_id"
  events:
    - schema: test
      name: archive_accounts_once
      definer: root@localhost
      time_zone: SYSTEM
      kind: one_time
      execute_at: "2031-01-01 00:00:00"
      interval_value: ~
      interval_unit: ~
      starts: ~
      ends: ~
      status: disabled
      completion: preserve
      comment: ~
      definition: SET @dbmd_mariadb_archive_requested = 1
      sql_mode: "STRICT_TRANS_TABLES,ERROR_FOR_DIVISION_BY_ZERO,NO_AUTO_CREATE_USER,NO_ENGINE_SUBSTITUTION"
      originator: 1
      character_set_client: utf8mb4
      collation_connection: utf8mb4_uca1400_ai_ci
      database_collation: utf8mb4_uca1400_ai_ci
      create_statement: "CREATE DEFINER=`root`@`localhost` EVENT `archive_accounts_once` ON SCHEDULE AT '2031-01-01 00:00:00' ON COMPLETION PRESERVE DISABLE DO SET @dbmd_mariadb_archive_requested = 1"
    - schema: test
      name: purge_disabled_accounts
      definer: root@localhost
      time_zone: SYSTEM
      kind: recurring
      execute_at: ~
      interval_value: "1"
      interval_unit: day
      starts: "2030-01-01 00:00:00"
      ends: ~
      status: disabled
      completion: preserve
      comment: Remove old disabled accounts
      definition: "DELETE FROM accounts WHERE status = 'disabled' AND row_end < CURRENT_TIMESTAMP - INTERVAL 365 DAY"
      sql_mode: "STRICT_TRANS_TABLES,ERROR_FOR_DIVISION_BY_ZERO,NO_AUTO_CREATE_USER,NO_ENGINE_SUBSTITUTION"
      originator: 1
      character_set_client: utf8mb4
      collation_connection: utf8mb4_uca1400_ai_ci
      database_collation: utf8mb4_uca1400_ai_ci
      create_statement: "CREATE DEFINER=`root`@`localhost` EVENT `purge_disabled_accounts` ON SCHEDULE EVERY 1 DAY STARTS '2030-01-01 00:00:00' ON COMPLETION PRESERVE DISABLE COMMENT 'Remove old disabled accounts' DO DELETE FROM accounts WHERE status = 'disabled' AND row_end < CURRENT_TIMESTAMP - INTERVAL 365 DAY"
  servers:
    - name: analytics_remote
      wrapper: mariadb
      host: db.internal
      database: analytics
      username: reader
      port: 3307
      socket: ~
      owner: platform
      options:
        - name: DATABASE
          value: analytics
          sensitive: false
        - name: HOST
