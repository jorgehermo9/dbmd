    - database: analytics
      name: retention_matrix
      uuid: 20000000-0000-0000-0000-000000000008
      kind: table
      engine: MergeTree
      engine_full: "MergeTree ORDER BY event_id TTL occurred_at + toIntervalDay(7) TO DISK 'default', occurred_at + toIntervalDay(10) TO VOLUME 'default', occurred_at + toIntervalDay(14) RECOMPRESS CODEC(ZSTD(9)), occurred_at + toIntervalDay(30) WHERE deleted = 1 SETTINGS index_granularity = 4096"
      engine_arguments: []
      engine_parameters: {}
      settings:
        index_granularity: "4096"
      ttl_rules:
        - expression: occurred_at + toIntervalDay(7)
          action:
            kind: move
            destination: disk
            target: "'default'"
          raw: "occurred_at + toIntervalDay(7) TO DISK 'default'"
        - expression: occurred_at + toIntervalDay(10)
          action:
            kind: move
            destination: volume
            target: "'default'"
          raw: "occurred_at + toIntervalDay(10) TO VOLUME 'default'"
        - expression: occurred_at + toIntervalDay(14)
          action:
            kind: recompress
            codec: CODEC(ZSTD(9))
          raw: occurred_at + toIntervalDay(14) RECOMPRESS CODEC(ZSTD(9))
        - expression: occurred_at + toIntervalDay(30)
          action:
            kind: delete
            predicate: deleted = 1
          raw: occurred_at + toIntervalDay(30) WHERE deleted = 1
