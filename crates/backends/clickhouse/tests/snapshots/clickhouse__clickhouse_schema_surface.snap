  functions:
    - name: analytics_normalize
      origin: sql_defined
      syntax: ~
      arguments: ~
      returned_value: ~
      definition: CREATE FUNCTION analytics_normalize AS value -> lowerUTF8(value)
  users:
    - name: analytics_service
      storage: local_directory
      authentication_types:
        - sha256_password
      valid_until:
        - ~
      hosts:
        ip: []
        names:
          - localhost
        name_regexps: []
        name_like_patterns: []
      default_roles:
        all: false
        include:
          - analytics_reader
        except: []
      grantees:
        all: true
        include: []
        except: []
      default_database: analytics
  roles:
    - name: analytics_reader
      storage: local_directory
  grants:
    - user: ~
      role: analytics_reader
      access_type: SELECT
      access_object: ~
      database: analytics
      table: ~
      column: ~
      partial_revoke: false
      grant_option: true
  role_grants:
    - user: analytics_service
      role: ~
      granted_role: analytics_reader
      default: true
      admin_option: true
  row_policies:
    - name: tenant_events ON analytics.events
      short_name: tenant_events
      database: analytics
      table: events
      storage: local_directory
      select_filter: tenant_id > 0
      restrictive: false
      target:
        all: false
        include:
          - analytics_reader
        except: []
  quotas:
    - name: analytics_quota
      storage: local_directory
      keys:
        - user_name
      target:
        all: false
        include:
          - analytics_reader
        except: []
      ipv4_prefix_bits: ~
      ipv6_prefix_bits: ~
      limits:
        - duration_seconds: 3600
          randomized: false
          max_queries: 100
          max_query_selects: 90
          max_query_inserts: 10
          max_errors: 5
          max_result_rows: 1000
          max_result_bytes: 2000
          max_read_rows: 3000
          max_read_bytes: 4000
          max_execution_time: "60"
          max_written_bytes: 5000
          max_failed_sequential_authentications: 3
          max_queries_per_normalized_hash: 7
  settings_profiles:
    - name: analytics_profile
      storage: local_directory
      target:
        all: false
        include:
          - analytics_reader
        except: []
      elements:
        - index: 0
          setting_name: max_threads
          value: "4"
          minimum: "1"
          maximum: "8"
          writability: WRITABLE
          inherited_profile: ~
  named_collections:
    - name: analytics_remote
      entries:
        - key: host
          overridable: true
        - key: password
          overridable: false
      definition: "CREATE NAMED COLLECTION analytics_remote AS host = '[HIDDEN]' OVERRIDABLE, password = '[HIDDEN]' NOT OVERRIDABLE"
      source: SQL
  resources:
    - name: analytics_cpu
      operations:
        - kind: master_thread
        - kind: worker_thread
      read_disks: []
      write_disks: []
      unit: CPUNanosecond
      definition: "CREATE RESOURCE analytics_cpu (MASTER THREAD, WORKER THREAD)"
  workloads:
    - name: analytics_all
      parent: ~
      settings: []
      definition: CREATE WORKLOAD analytics_all
    - name: analytics_interactive
      parent: analytics_all
      settings:
        - name: max_concurrent_threads
          value: "8"
          resource: analytics_cpu
      definition: CREATE WORKLOAD analytics_interactive IN analytics_all SETTINGS max_concurrent_threads = 8 FOR analytics_cpu
