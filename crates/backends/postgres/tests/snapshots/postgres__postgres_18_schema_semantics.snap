  publications:
    - name: all_tables
      owner: postgres
      all_tables: true
      publish_insert: true
      publish_update: false
      publish_delete: false
      publish_truncate: false
      publish_via_partition_root: false
      generated_columns: none
      schemas: []
      tables: []
      comment: ~
    - name: temporal_changes
      owner: postgres
      all_tables: false
      publish_insert: true
      publish_update: false
      publish_delete: false
      publish_truncate: false
      publish_via_partition_root: false
      generated_columns: stored
      schemas: []
      tables:
        - namespace: temporal
          name: accounts
          columns:
            - account_id
            - stored_amount
          row_filter: base_amount >= 0
      comment: Stored generated values for analytics
    - name: temporal_schema
      owner: postgres
      all_tables: false
      publish_insert: true
      publish_update: false
      publish_delete: false
      publish_truncate: true
      publish_via_partition_root: false
      generated_columns: none
      schemas:
        - temporal
      tables: []
      comment: ~
  subscriptions: []
  privileges:
    - object_kind: schema
      object_identity: public
      grantor: pg_database_owner
      grantee: PUBLIC
      privilege: usage
      grantable: false
    - object_kind: schema
      object_identity: public
      grantor: pg_database_owner
      grantee: pg_database_owner
      privilege: create
      grantable: false
