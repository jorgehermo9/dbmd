    email
   FROM catalog.accounts
  WHERE state = 'active'::catalog.account_state;
```

## Functions

### `catalog.normalize_email(value text)`

Normalizes an email address

**Kind:** `ordinary`

**Arguments:** `value text`

**Returns:** `text`

**Owner:** `postgres`

**Language:** `sql`

**Volatility:** `immutable`

**Parallel:** `safe`

**Security:** `invoker`

**Null input:** called

**Leakproof:** no

**Returns set:** no

**Cost:** 100

```sql
CREATE OR REPLACE FUNCTION catalog.normalize_email(value text)
 RETURNS text
 LANGUAGE sql
 IMMUTABLE PARALLEL SAFE
RETURN lower(TRIM(BOTH FROM value))

```


## Procedures

### `catalog.archive_account(IN account_id bigint, INOUT archived boolean, IN reason text)`

Marks an account archive request

**Arguments:** `IN account_id bigint, INOUT archived boolean, IN reason text DEFAULT 'manual'::text`

**Owner:** `postgres`

**Language:** `plpgsql`

**Security:** `definer`

**Setting:** `search_path=catalog, pg_temp`

```sql
CREATE OR REPLACE PROCEDURE catalog.archive_account(IN account_id bigint, INOUT archived boolean, IN reason text DEFAULT 'manual'::text)
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'catalog', 'pg_temp'
AS $procedure$
BEGIN
    archived := account_id > 0 AND reason <> '';
END;
$procedure$

```


