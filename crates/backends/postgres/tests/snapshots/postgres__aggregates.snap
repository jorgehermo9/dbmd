    - namespace: aggregates
      name: pick_integer
      extension: ~
      signature: "(state integer[], fraction double precision)"
      arguments: "state integer[], fraction double precision"
      definition: "CREATE OR REPLACE FUNCTION aggregates.pick_integer(state integer[], fraction double precision)\n RETURNS integer\n LANGUAGE sql\n IMMUTABLE PARALLEL SAFE\nRETURN (SELECT value.value FROM unnest(pick_integer.state) value(value) ORDER BY value.value OFFSET LEAST((cardinality(pick_integer.state) - 1), GREATEST(0, (floor((pick_integer.fraction * ((cardinality(pick_integer.state) - 1))::double precision)))::integer)) LIMIT 1)\n"
      comment: ~
      return_type: integer
      owner: postgres
