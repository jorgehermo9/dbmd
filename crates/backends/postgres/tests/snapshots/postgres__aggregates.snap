      definition: "CREATE OR REPLACE FUNCTION aggregates.hypothetical_position(state integer[], hypothetical integer)\n RETURNS bigint\n LANGUAGE sql\n IMMUTABLE PARALLEL SAFE\nRETURN (SELECT (1 + count(*)) FROM unnest(hypothetical_position.state) value(value) WHERE (value.value < hypothetical_position.hypothetical))\n"
      comment: ~
      return_type: bigint
      owner: postgres
      kind: ordinary
