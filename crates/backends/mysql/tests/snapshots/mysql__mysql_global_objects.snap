---
source: crates/backends/mysql/tests/mysql.rs
expression: first
---
id: global
display_name: ~
catalog:
  schemas:
    - name: test
      default_character_set: utf8mb4
      default_collation: utf8mb4_0900_ai_ci
      default_encryption: false
      read_only: true
  tables:
    - schema: test
      name: accounts
      engine: InnoDB
      row_format: Dynamic
      collation: utf8mb4_0900_ai_ci
      comment: ~
      create_options: ~
      engine_attribute: ~
      secondary_engine_attribute: ~
      columns:
        - name: account_id
          position: 1
          data_type: bigint
          column_type: bigint unsigned
          nullable: false
          default: ~
          extra: ""
          generation_expression: ~
          character_set: ~
          collation: ~
          comment: ~
          visible: true
          srs_id: ~
          engine_attribute: ~
          secondary_engine_attribute: ~
          masking_policy_configured: false
        - name: email
          position: 2
          data_type: varchar
          column_type: varchar(255)
          nullable: false
          default: ~
          extra: ""
          generation_expression: ~
          character_set: utf8mb4
          collation: utf8mb4_0900_ai_ci
          comment: ~
          visible: true
          srs_id: ~
          engine_attribute: ~
          secondary_engine_attribute: ~
          masking_policy_configured: false
      constraints:
        - name: PRIMARY
          kind: primary_key
          columns:
            - account_id
          referenced_schema: ~
          referenced_table: ~
          referenced_columns: []
          match_type: ~
          on_update: ~
          on_delete: ~
          expression: ~
          enforced: true
          engine_attribute: ~
          secondary_engine_attribute: ~
      indexes:
        - name: PRIMARY
          unique: true
          index_type: BTREE
          visible: true
          comment: ~
          disabled_reason: ~
          terms:
            - position: 1
              column: account_id
              expression: ~
              prefix_length: ~
              sort_order: ascending
      partitions: []
      definition: "CREATE TABLE `accounts` (\n  `account_id` bigint unsigned NOT NULL,\n  `email` varchar(255) NOT NULL,\n  PRIMARY KEY (`account_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci"
  views: []
  routines:
    - schema: test
      name: rotate_accounts
      kind: procedure
      return_type: ~
      body: SQL
      definition: SELECT COUNT(*) FROM accounts
      create_statement: "CREATE DEFINER=`root`@`localhost` PROCEDURE `rotate_accounts`()\n    READS SQL DATA\nSELECT COUNT(*) FROM accounts"
      external_language: SQL
      deterministic: false
      data_access: reads_sql_data
      security: definer
      definer: root@localhost
      comment: ~
      parameters: []
      sql_mode: "ONLY_FULL_GROUP_BY,STRICT_TRANS_TABLES,NO_ZERO_IN_DATE,NO_ZERO_DATE,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION"
      character_set_client: latin1
      collation_connection: latin1_swedish_ci
      database_collation: utf8mb4_0900_ai_ci
      libraries: []
  triggers: []
  events: []
  libraries: []
  servers:
    - name: dbmd_remote
      wrapper: mysql
      host: 198.51.100.10
      database: remote_database
      username: remote_user
      port: 3306
      socket: ""
      owner: dbmd
      password_configured: true
  spatial_reference_systems:
    - id: 33001
      name: dbmd geographic
      organization: dbmd
      organization_id: 33001
      definition: "GEOGCS[\"dbmd geographic\",DATUM[\"dbmd datum\",SPHEROID[\"dbmd sphere\",6378137,298.257223563]],PRIMEM[\"Greenwich\",0],UNIT[\"degree\",0.017453292519943278],AXIS[\"Latitude\",NORTH],AXIS[\"Longitude\",EAST]]"
      description: Application-defined fixture SRS
  tablespaces:
    - name: dbmd_general
      engine: InnoDB
      row_format: Any
      page_size: 16384
      autoextend_size: 4194304
      space_type: General
      encryption: N
      engine_attribute: ~
      file_locations_redacted: true
    - name: mysql
      engine: InnoDB
      row_format: Any
      page_size: 16384
      autoextend_size: 0
      space_type: General
      encryption: N
      engine_attribute: ~
      file_locations_redacted: true
  resource_groups:
