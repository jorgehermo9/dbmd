  views:
    - schema: test
      name: active_accounts
      kind: sql
      definition: "select `test`.`accounts`.`tenant_id` AS `tenant_id`,`test`.`accounts`.`account_id` AS `account_id`,`test`.`accounts`.`email` AS `email` from `test`.`accounts` where (`test`.`accounts`.`status` = 'active')"
      check_option: cascaded
      updatable: true
      security: invoker
      definer: root@localhost
      character_set: latin1
      collation: latin1_swedish_ci
