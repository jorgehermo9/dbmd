    - schema: test
      name: archive_accounts_once
      definer: root@localhost
      time_zone: SYSTEM
      kind: one_time
      execute_at: "2031-01-01 00:00:00"
      interval_value: ~
      interval_field: ~
      starts: ~
      ends: ~
      status: disabled
      completion: preserve
      comment: ~
      definition: SET @dbmd_archive_requested = 1
      sql_mode: "ONLY_FULL_GROUP_BY,STRICT_TRANS_TABLES,NO_ZERO_IN_DATE,NO_ZERO_DATE,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION"
      originator: 1
      character_set_client: latin1
      collation_connection: latin1_swedish_ci
      database_collation: utf8mb4_0900_ai_ci
      create_statement: "CREATE DEFINER=`root`@`localhost` EVENT `archive_accounts_once` ON SCHEDULE AT '2031-01-01 00:00:00' ON COMPLETION PRESERVE DISABLE DO SET @dbmd_archive_requested = 1"
    - schema: test
      name: purge_disabled_accounts
      definer: root@localhost
      time_zone: SYSTEM
      kind: recurring
      execute_at: ~
      interval_value: "1"
      interval_field: DAY
      starts: "2030-01-01 00:00:00"
      ends: ~
      status: disabled
      completion: preserve
      comment: Remove old disabled accounts
      definition: "DELETE FROM accounts WHERE status = 'disabled' AND updated_at < CURRENT_TIMESTAMP - INTERVAL 365 DAY"
      sql_mode: "ONLY_FULL_GROUP_BY,STRICT_TRANS_TABLES,NO_ZERO_IN_DATE,NO_ZERO_DATE,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION"
      originator: 1
      character_set_client: latin1
      collation_connection: latin1_swedish_ci
      database_collation: utf8mb4_0900_ai_ci
      create_statement: "CREATE DEFINER=`root`@`localhost` EVENT `purge_disabled_accounts` ON SCHEDULE EVERY 1 DAY STARTS '2030-01-01 00:00:00' ON COMPLETION PRESERVE DISABLE COMMENT 'Remove old disabled accounts' DO DELETE FROM accounts WHERE status = 'disabled' AND updated_at < CURRENT_TIMESTAMP - INTERVAL 365 DAY"
