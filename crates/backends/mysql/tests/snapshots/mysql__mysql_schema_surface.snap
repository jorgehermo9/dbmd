  views:
    - schema: test
      name: active_accounts
      definition: "select `test`.`accounts`.`tenant_id` AS `tenant_id`,`test`.`accounts`.`account_id` AS `account_id`,`test`.`accounts`.`email` AS `email` from `test`.`accounts` where (`test`.`accounts`.`status` = 'active')"
      check_option: CASCADED
      updatable: true
      security_type: INVOKER
      definer: root@localhost
      character_set: latin1
      collation: latin1_swedish_ci
      create_statement: "CREATE ALGORITHM=UNDEFINED DEFINER=`root`@`localhost` SQL SECURITY INVOKER VIEW `active_accounts` AS select `accounts`.`tenant_id` AS `tenant_id`,`accounts`.`account_id` AS `account_id`,`accounts`.`email` AS `email` from `accounts` where (`accounts`.`status` = 'active') WITH CASCADED CHECK OPTION"
  routines:
    - schema: test
      name: disable_account
      kind: PROCEDURE
      return_type: ~
      body: SQL
      definition: "UPDATE accounts SET status = 'disabled' WHERE account_id = target_id"
      deterministic: false
      sql_data_access: MODIFIES SQL DATA
      security_type: DEFINER
      definer: root@localhost
      comment: ~
      parameters:
        - position: 1
          mode: IN
          name: target_id
          data_type: bigint
          dtd_identifier: bigint unsigned
    - schema: test
      name: normalize_email
      kind: FUNCTION
      return_type: varchar(255)
      body: SQL
      definition: RETURN lower(value)
      deterministic: true
      sql_data_access: NO SQL
      security_type: DEFINER
      definer: root@localhost
      comment: ~
      parameters:
        - position: 0
          mode: ~
          name: ~
          data_type: varchar
          dtd_identifier: varchar(255)
        - position: 1
          mode: IN
          name: value
          data_type: varchar
          dtd_identifier: varchar(255)
  triggers:
    - schema: test
      name: accounts_updated
      table: accounts
      event: UPDATE
      timing: BEFORE
      orientation: ROW
      statement: SET NEW.updated_at = CURRENT_TIMESTAMP
      action_order: 1
      sql_mode: "ONLY_FULL_GROUP_BY,STRICT_TRANS_TABLES,NO_ZERO_IN_DATE,NO_ZERO_DATE,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION"
      definer: root@localhost
      character_set: latin1
      collation: latin1_swedish_ci
  events:
    - schema: test
      name: purge_disabled_accounts
      definer: root@localhost
      time_zone: SYSTEM
      event_type: RECURRING
      execute_at: ~
      interval_value: "1"
      interval_field: DAY
      starts: "2030-01-01 00:00:00"
      ends: ~
      status: DISABLED
      on_completion: PRESERVE
      comment: Remove old disabled accounts
      definition: "DELETE FROM accounts WHERE status = 'disabled' AND updated_at < CURRENT_TIMESTAMP - INTERVAL 365 DAY"
