      table_kind: table
      tablespace: ~
      inherits: []
      partition_key: ~
      partition_parent: ~
      partition_bound: ~
      row_level_security: false
      force_row_level_security: false
      policies: []
views:
  - namespace: catalog
    name: account_counts
    definition: " SELECT state,\n    count(*) AS account_count\n   FROM catalog.accounts\n  GROUP BY state;"
    materialized: true
    comment: ~
    columns:
      - name: state
        data_type: catalog.account_state
        nullable: true
        default: ~
        comment: ~
        backend:
          backend: postgres
          enum_values:
            - invited
            - active
            - suspended
          identity: ~
          generated: ~
      - name: account_count
        data_type: bigint
        nullable: true
        default: ~
        comment: ~
        backend:
          backend: postgres
          enum_values: []
          identity: ~
          generated: ~
  - namespace: catalog
    name: active_accounts
    definition: " SELECT id,\n    email\n   FROM catalog.accounts\n  WHERE state = 'active'::catalog.account_state;"
    materialized: false
    comment: Accounts allowed to sign in
    columns:
      - name: id
        data_type: bigint
        nullable: true
        default: ~
        comment: ~
        backend:
          backend: postgres
          enum_values: []
          identity: ~
          generated: ~
      - name: email
        data_type: text
        nullable: true
        default: ~
        comment: ~
        backend:
          backend: postgres
          enum_values: []
          identity: ~
          generated: ~
triggers: []
functions:
  - namespace: catalog
    name: normalize_email
    signature: (value text)
    definition: "CREATE OR REPLACE FUNCTION catalog.normalize_email(value text)\n RETURNS text\n LANGUAGE sql\n IMMUTABLE PARALLEL SAFE\nRETURN lower(TRIM(BOTH FROM value))\n"
    comment: Normalizes an email address
    backend:
      backend: postgres
      return_type: text
      language: sql
      volatility: immutable
      parallel: safe
      security_definer: false
