    name: account_state
    comment: Lifecycle of an account
    values:
      - invited
      - active
      - suspended
tables:
  - namespace: catalog
    name: accounts
    comment: ~
    columns:
      - name: id
        data_type: bigint
        nullable: false
        default: ~
        comment: ~
