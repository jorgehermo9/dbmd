          backend: postgres
          enum_values: []
          identity: ~
          generated: ~
      - name: state
        data_type: catalog.account_state
        nullable: false
        default: "'invited'::catalog.account_state"
        comment: ~
        backend:
          backend: postgres
          enum_values:
            - invited
            - active
            - suspended
          identity: ~
          generated: ~
    constraints:
      - name: accounts_pkey
        kind: primary_key
        columns:
          - id
        expression: ~
        references: ~
        backend:
          backend: postgres
          definition: PRIMARY KEY (id)
          deferrable: false
          initially_deferred: false
          validated: true
          locally_defined: true
          no_inherit: true
    indexes:
      - name: accounts_pkey
        unique: true
        terms:
          - target:
              column: id
            collation: ~
            operator_class: pg_catalog.int8_ops
            order: ascending
            nulls_order: last
        predicate: ~
        definition: CREATE UNIQUE INDEX accounts_pkey ON catalog.accounts USING btree (id)
        backend:
          backend: postgres
          method: btree
          predicate: ~
          included_columns: []
          nulls_not_distinct: false
          valid: true
          ready: true
          clustered: false
          replica_identity: false
    backend:
