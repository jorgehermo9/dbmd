triggers:
  - namespace: main
    name: document_summaries_insert
    target_namespace: main
    target: document_summaries
    timing: instead_of
    event:
      event: insert
    when_expression: ~
    definition: "CREATE TRIGGER document_summaries_insert\nINSTEAD OF INSERT ON document_summaries\nBEGIN\n    INSERT INTO documents (id, title, body)\n    VALUES (NEW.document_id, NEW.heading, '');\nEND"
  - namespace: main
    name: documents_prevent_root_delete
    target_namespace: main
    target: documents
    timing: before
    event:
      event: delete
    when_expression: OLD.id = 0
    definition: "CREATE TRIGGER documents_prevent_root_delete\nBEFORE DELETE ON documents\nWHEN OLD.id = 0\nBEGIN\n    SELECT RAISE(IGNORE);\nEND"
  - namespace: main
    name: documents_touch_updated_at
    target_namespace: main
    target: documents
    timing: after
    event:
      event: update
      columns:
        - title
        - body
    when_expression: NEW.updated_at = OLD.updated_at
    definition: "CREATE TRIGGER documents_touch_updated_at\nAFTER UPDATE OF title, body ON documents\nFOR EACH ROW\nWHEN NEW.updated_at = OLD.updated_at\nBEGIN\n    UPDATE documents\n    SET updated_at = CURRENT_TIMESTAMP\n    WHERE id = NEW.id;\nEND"
